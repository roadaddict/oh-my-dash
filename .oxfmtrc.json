{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 160,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "ignorePatterns": [
    "public/**",
    "test/.build/**",
    "test/fixtures/widgets/broken-syntax/**",
    "lib/integrations/index.js",
    "*.md",
    "app/index.html",
    "package.json",
    "package-lock.json",
    "wrangler.jsonc"
  ]
}
